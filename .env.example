# Public client-side configuration only. Never place secrets in REACT_APP_* values.
REACT_APP_ROBOT_API_URL=http://ROBOT_HOST:5002
REACT_APP_GESTURE_API=http://GESTURE_HOST:7001
REACT_APP_MISSION_CONTROL_URL=http://MISSION_HOST:5000
REACT_APP_GOOGLE_MAPS_API_KEY=

# Local demo mode only. Production authentication must be enforced server-side.
REACT_APP_AUTH_MODE=disabled
REACT_APP_DEMO_USERNAME=
REACT_APP_DEMO_PASSWORD=
